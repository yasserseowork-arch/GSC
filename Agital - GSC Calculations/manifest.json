{
  "manifest_version": 3,
  "name": "Agital GSC Auto Reporter",
  "version": "2.0.0",
  "description": "Creates week-over-week Google Search Console screenshots and adds Agital percentage calculations automatically.",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://search.google.com/*"
  ],
  "action": {
    "default_title": "Agital GSC Auto Reporter",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
