{
  "manifest_version": 3,
  "name": "GSC Snapshot Pro",
  "version": "2.3.0",
  "description": "Yasser SEO week-over-week Search Console snapshots with calculated performance changes.",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "sidePanel",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://search.google.com/*"
  ],
  "action": {
    "default_title": "GSC Snapshot Pro"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
